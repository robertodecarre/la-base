{
  "name": "immersive-3d-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "optimize:models": "gltf-transform optimize public/models/src/*.glb public/models/ --compress meshopt --texture-compress ktx2"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.0",
    "@types/three": "^0.186.0",
    "lil-gui": "^0.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-glsl": "^1.5.0"
  }
}
